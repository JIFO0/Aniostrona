CMS_PASSWORD=zmien-to-haslo
CMS_SECRET=losowy-dlugi-sekret
# Push na GitHub z CMS w dockerze zwykle nie działa (wolumen :ro na .git + token).
# Zostaw 0. Treści ściągasz lokalnie: npm run content:pull (SSH JIFO-SERVER)
# albo panel JIFOCC → Treści CMS (ZIP / snapshot git na Lenovo, bez GitHub).
CMS_GIT_PUSH=0
# Lokalnie / na hoście: katalog repozytorium.
# W dockerze (workdir /app): CMS_ROOT=/app  — hostowy /home/jifo/... wewnątrz kontenera nie istnieje.
CMS_ROOT=/app

